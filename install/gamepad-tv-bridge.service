[Unit]
Description=Gamepad TV Bridge — gamepad to keyboard daemon
# Ordering only, and only when a graphical session happens to be in the same
# transaction. It is NOT a requirement: see the [Install] section — the daemon
# has to be up in the GameCore console session too, which never reaches this
# target.
After=graphical-session.target
# Give up after 5 failed starts in 60s rather than restarting for ever: a loop
# that never ends hides the fault it is looping on.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# No SupplementaryGroups= here — it is not supported in a --user unit, and
# systemd refused to start the service at all (status=216/GROUP). With
# Restart=on-failure and RestartSec=3 that was a failed start every three
# seconds for ever: the gamepad never worked in any kiosk, and the user journal
# filled with the same line. It was redundant anyway — install/fix-permissions.sh
# adds the user to `input`, and the session inherits it.
#
# No Environment=DISPLAY=:0 either. That is the display manager's X server, not
# the session's, and no XAUTHORITY came with it, so every xprop call failed and
# _scan_firefox_window() returned None. That kills the *title* fallback only —
# _detect_active() first reads the Firefox --profile name out of /proc, which
# needs no X, so a GameCore kiosk tile still matched. Measured on a real box:
# ":0" did not answer while the session was on ":1", and the journal showed
# profile matches working throughout. DISPLAY and XAUTHORITY come from the
# session instead — Plasma runs `systemctl --user import-environment` for
# exactly this. See the README.
ExecStart=%h/.venv/bin/python -m gamepad_bridge start
Restart=on-failure
RestartSec=3

[Install]
# default.target, NOT graphical-session.target. A GameCore box runs its kiosk
# from `gamecore-session.target`, which deliberately never reaches
# `graphical-session.target` — with linger on, the user manager starts at boot,
# before any graphical login, so that target says nothing about whether a
# session exists. Hung off graphical-session.target the daemon started only
# when someone dropped to the KDE desktop, and the gamepad was dead on every
# kiosk tile launched from GameCore itself: YouTube launched at 08:09, the
# bridge's first log line was at 08:20:54, right after `startplasma-wayland`.
# Nothing in the journal but the daemon never having run at all.
#
# Nothing here needs a session: the daemon reads evdev, writes uinput, and
# finds the active kiosk by reading the Firefox --profile name out of /proc.
# Restart=on-failure covers the window where /dev/uinput is not ready yet.
WantedBy=default.target
