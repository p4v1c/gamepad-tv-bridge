[Unit]
Description=Stremio TV — local streaming server (EngineFS on 11470)
After=network-online.target

[Service]
Type=simple
# Réutilise le `server.js` officiel embarqué dans le flatpak Stremio, mais lancé
# avec le node de l'HÔTE : le ffmpeg du runtime flatpak ne sait pas décoder le
# HEVC, ce qui fait échouer le transcodage HLS (voir stremio-server.sh, qui gère
# la détection et le repli). Il écoute sur 127.0.0.1:11470, que l'UI web détecte
# automatiquement.
Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env bash /opt/gamepad-tv-bridge/install/stremio-server.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
